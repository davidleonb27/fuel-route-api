{
  "info": {
    "name": "Fuel Route Optimizer API",
    "description": "Route between two US locations with the cheapest fuel stops (500 mi range, 10 MPG).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Plan: New York to Los Angeles (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/route-plan/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "route-plan",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "Coast to coast. Send twice: the second response comes from cache with meta.cached = true and 0 API calls."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"At most one routing API call\", () => pm.expect(body.meta.routing_api_calls).to.be.at.most(1));",
              "pm.test(\"No stop buys more than a 50 gallon tank\", () => body.fuel_stops.forEach(s => pm.expect(s.gallons).to.be.at.most(50)));",
              "pm.test(\"Total cost equals the sum of stops\", () => {",
              "  const sum = body.fuel_stops.reduce((a, s) => a + s.cost, 0);",
              "  pm.expect(Math.abs(sum - body.summary.total_fuel_cost)).to.be.below(0.05);",
              "});",
              "pm.test(\"Fuel bought plus starting fuel covers the trip at 10 MPG\", () => pm.expect(Math.abs(body.summary.gallons_purchased + body.vehicle.initial_fuel_gallons - body.route.distance_miles / 10)).to.be.below(0.6));",
              "console.log(`Total $${body.summary.total_fuel_cost} over ${body.summary.number_of_stops} stops, ${pm.response.responseTime} ms`);",
              "console.log(\"Map:\", body.map_url);"
            ]
          }
        }
      ]
    },
